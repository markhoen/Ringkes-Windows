<Window x:Class="Ringkes.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Ringkes"
        Height="420"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="10">

        <Border Background="White"
                CornerRadius="20"
                Padding="10">

            <StackPanel>

                <!-- LOGO -->
                <Border Width="96"
                        Height="96"
                        CornerRadius="24"
                        Background="#F7F7F7"
                        HorizontalAlignment="Center">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                      ShadowDepth="1"
                      Opacity="0.12"/>
                    </Border.Effect>
                    
                    <Image x:Name="LogoImage"
                           Width="72"
                           Height="72"/>

                </Border>

                <!-- APP NAME -->
                <TextBlock Text="Ringkes"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

                <!-- VERSION -->
                <TextBlock Text="Version 1.0"
                           FontSize="13"
                           Foreground="Gray"
                           Margin="0,1,0,0"
                           HorizontalAlignment="Center"/>

                <!-- DESCRIPTION -->
                <TextBlock Text="Cilik Ukurane, Gedhe Manfaate"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#404040"/>

                <TextBlock Text="Lightweight PDF compression utility powered by Ghostscript."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           FontSize="13"
                           Foreground="#404040"/>

                <!-- DEPENDENCY -->
                <Border Background="#F8F8F8"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,5,0,0">

                    <StackPanel>

                        <TextBlock Text="Dependencies"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBlock Text="• Ghostscript Embedded"
                                   Margin="0,2,0,0"
                                   FontSize="12"/>

                        <TextBlock Text="• .NET Framework 4.8.1"
                                   Margin="0,2,0,0"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>

                <!-- COPYRIGHT -->
                <TextBlock Text="© 2026 R. Mardiansyah"
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,24,0,0"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>