<Window x:Class="Ringkes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ringkes"
        mc:Ignorable="d"
        Title="Ringkes"
        Height="700"
        Width="500"
        MinHeight="500"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP MENU -->
        <Menu Grid.Row="0"
              Height="28"
              Margin="0,0,0,10">

            <MenuItem Header="About">

                <MenuItem Header="About Ringkes"
                          Click="About_Click"/>

            </MenuItem>

        </Menu>

        <!-- HEADER -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="16"
                Margin="0,0,0,14">

            <DockPanel LastChildFill="False">

                <!-- LEFT -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">

                    <!-- LOGO -->
                    <Border Width="74"
                            Height="74"
                            CornerRadius="18"
                            Background="#F8F8F8"
                            Margin="0,0,14,0">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              ShadowDepth="1"
                                              Opacity="0.12"/>
                        </Border.Effect>

                        <Image x:Name="LogoImage"
                               Width="56"
                               Height="56"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    </Border>

                    <!-- TITLE -->
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Ringkes"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#202020"/>

                        <TextBlock Text="Cilik Ukurane, Gedhe Manfaate"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="#707070"/>

                    </StackPanel>

                </StackPanel>

                <!-- RIGHT -->
                <Border Background="#F8F8F8"
                        CornerRadius="10"
                        Padding="12,8"
                        DockPanel.Dock="Right"
                        Height="40">

                    <CheckBox x:Name="OverwriteCheckBox"
                              Content="Overwrite Original File(s)"
                              FontSize="12"
                              VerticalAlignment="Center"/>

                </Border>

            </DockPanel>

        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
            Background="White"
            CornerRadius="12"
            Padding="12"
            Margin="0,0,0,14">

            <DockPanel>

                <StackPanel Orientation="Horizontal">

                    <!-- GHOSTSCRIPT -->
                    <StackPanel Orientation="Horizontal"
                        Margin="0,0,18,0">

                        <Ellipse Width="10"
                         Height="10"
                         Fill="LimeGreen"
                         VerticalAlignment="Center"/>

                        <TextBlock Text=" Ghostscript"
                           FontSize="11"
                           Foreground="#606060"
                           VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- EMBEDDED -->
                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="10"
                         Height="10"
                         Fill="DodgerBlue"
                         VerticalAlignment="Center"/>

                        <TextBlock Text=" Embedded"
                           FontSize="11"
                           Foreground="#606060"
                           VerticalAlignment="Center"/>

                        <TextBlock Text=" gswin64c.exe"
                           DockPanel.Dock="Right"
                           FontSize="10"
                           Foreground="#909090"
                           VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

                <!-- PATH -->
                

            </DockPanel>

        </Border>

        <!-- MODE SELECTOR -->
        <Border Grid.Row="3"
            Background="White"
            CornerRadius="12"
            Padding="6"
            Margin="0,0,0,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CompressModeButton"
                    Grid.Column="0"
                    Content="Compress"
                    Height="32"
                    Click="CompressModeButton_Click"/>

                <Button x:Name="MergeModeButton"
                    Grid.Column="1"
                    Content="Merge"
                    Height="32"
                    Margin="6,0,0,0"
                    Click="MergeModeButton_Click"/>

            </Grid>

        </Border>

        <!-- DROP AREA -->
        <Border Grid.Row="4"
                Panel.ZIndex="1"
                Margin="0,0,0,14"
                CornerRadius="18"
                BorderThickness="2"
                BorderBrush="#D7D7D7"
                Background="White"
                AllowDrop="True"
                Drop="DropArea_Drop"
                DragOver="DropArea_DragOver"
                SnapsToDevicePixels="True">

            <Grid>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="DropIconText"
                       Text="📄"
                       FontSize="42"
                       HorizontalAlignment="Center"/>

                    <TextBlock x:Name="DropTitleText"
                       Text="Drag &amp; Drop PDF or Images"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>

                    <TextBlock x:Name="DropSubtitleText"
                       Text="PDF COMPRESS • IMAGE TO PDF"
                       FontSize="11"
                       Foreground="#808080"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- FILE LIST -->
        <ListView x:Name="FileListView"
              Grid.Row="5"
              Panel.ZIndex="0"
              BorderThickness="0"
              Background="Transparent"
              HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border Background="White"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <!-- FILE NAME -->
                            <TextBlock Text="{Binding FileName}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#202020"/>

                            <!-- STATUS -->
                            <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       Margin="0,4,0,8"
                                       Foreground="#707070"/>

                            <!-- PROGRESS -->
                            <Grid Height="18">

                                <!-- BAR -->
                                <ProgressBar Value="{Binding Progress}"
                                             Maximum="100"
                                             Height="16"
                                             VerticalAlignment="Center"/>

                                <!-- TEXT -->
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           Foreground="#202020"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

        <ListView x:Name="MergeHistoryListView"
              Grid.Row="5"
              Visibility="Collapsed"
              BorderThickness="0"
              Background="Transparent"
              HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border Background="White"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <!-- HEADER -->
                            <Grid Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding OutputPath}"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">

                                    <Button Width="24"
                                            Height="24"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding OutputPath}"
                                            Click="OpenMergedFile_Click"
                                            ToolTip="Open File">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Text="&#xE8A7;"/>

                                    </Button>

                                    <Button Width="24"
                                            Height="24"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding OutputPath}"
                                            Click="OpenMergedFolder_Click"
                                            ToolTip="Open Folder">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Text="&#xED43;"/>

                                    </Button>

                                </StackPanel>

                            </Grid>

                            <!-- PATH -->
                            <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="#707070"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OutputPath}"
                                   Text="{Binding FolderName,
                                                  StringFormat=📂 {0}}"/>

                            <!-- SOURCE COUNT -->
                            <TextBlock Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="#707070">

                                    <Run Text="{Binding SourceCount}"/>
                                    <Run Text=" PDF file(s) • "/>
                                    <Run Text="{Binding CreatedAt,
                                                StringFormat={}{0:dd MMM yyyy HH:mm}}"/>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

        <Grid x:Name="MergeProgressPanel"
              Grid.Row="5"
              Visibility="Collapsed">

            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="320">

                <TextBlock Text="📄"
                   FontSize="42"
                   HorizontalAlignment="Center"/>

                <TextBlock x:Name="MergeProgressTitle"
                   Text="Merging PDF files..."
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,10,0,15"
                   HorizontalAlignment="Center"/>

                <ProgressBar x:Name="MergeProgressBar"
                     Height="18"
                     IsIndeterminate="True"/>

                <TextBlock x:Name="MergeOutputText"
                   Margin="0,12,0,0"
                   FontSize="11"
                   Foreground="#707070"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>

            </StackPanel>

        </Grid>

        <!-- FOOTER/ACTION -->
        <Border Grid.Row="6"
            Background="White"
            CornerRadius="12"
            Padding="10"
            Margin="0,8,0,0">

            <DockPanel LastChildFill="False">

                <TextBlock x:Name="FooterText"
                   FontSize="11"
                   Foreground="#707070"
                   VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Right">

                    <Button x:Name="ManageFilesButton"
                    Content="Manage Files"
                    Width="110"
                    Height="28"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    IsEnabled="False"
                    Click="ManageFilesButton_Click"/>

                    <Button x:Name="MergeButton"
                    Content="Merge"
                    Width="90"
                    Height="28"
                    Visibility="Collapsed"
                    IsEnabled="False"
                    Click="MergeButton_Click"/>

                    <Button x:Name="ClearFinishedButton"
                    Content="Clear Finished"
                    Width="110"
                    Height="28"
                    Click="ClearFinished_Click"/>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>

</Window>