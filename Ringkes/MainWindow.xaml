<Window x:Class="Ringkes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ringkes"
        mc:Ignorable="d"
        Title="Ringkes"
        Height="500"
        Width="500"
        MinHeight="500"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP MENU -->
        <Menu Grid.Row="0"
              Height="28"
              Margin="0,0,0,10">

            <MenuItem Header="About">

                <MenuItem Header="About Ringkes"
                          Click="About_Click"/>

            </MenuItem>

        </Menu>

        <!-- HEADER -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="16"
                Margin="0,0,0,14">

            <DockPanel LastChildFill="False">

                <!-- LEFT -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">

                    <!-- LOGO -->
                    <Border Width="74"
                            Height="74"
                            CornerRadius="18"
                            Background="#F8F8F8"
                            Margin="0,0,14,0">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              ShadowDepth="1"
                                              Opacity="0.12"/>
                        </Border.Effect>

                        <Image x:Name="LogoImage"
                               Width="56"
                               Height="56"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    </Border>

                    <!-- TITLE -->
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Ringkes"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#202020"/>

                        <TextBlock Text="Cilik Ukurane, Gedhe Manfaate"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="#707070"/>

                    </StackPanel>

                </StackPanel>

                <!-- RIGHT -->
                <Border Background="#F8F8F8"
                        CornerRadius="10"
                        Padding="12,8"
                        DockPanel.Dock="Right"
                        Height="40">

                    <CheckBox x:Name="OverwriteCheckBox"
                              Content="Overwrite Original File(s)"
                              FontSize="12"
                              VerticalAlignment="Center"/>

                </Border>

            </DockPanel>

        </Border>

        <!-- DROP AREA -->
        <Border Grid.Row="2"
                Margin="0,0,0,14"
                CornerRadius="18"
                BorderThickness="2"
                BorderBrush="#D7D7D7"
                Background="White"
                AllowDrop="True"
                Drop="DropArea_Drop"
                DragOver="DropArea_DragOver">

            <Grid>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="📄"
                               FontSize="42"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Drag &amp; Drop Multiple PDF"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Ghostscript Powered Compression"
                               FontSize="11"
                               Foreground="#808080"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- FILE LIST -->
        <ListView x:Name="FileListView"
                  Grid.Row="3"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border Background="White"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <!-- FILE NAME -->
                            <TextBlock Text="{Binding FileName}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#202020"/>

                            <!-- STATUS -->
                            <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       Margin="0,4,0,8"
                                       Foreground="#707070"/>

                            <!-- PROGRESS -->
                            <Grid Height="18">

                                <!-- BAR -->
                                <ProgressBar Value="{Binding Progress}"
                                             Maximum="100"
                                             Height="16"
                                             VerticalAlignment="Center"/>

                                <!-- TEXT -->
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           Foreground="#202020"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Window>