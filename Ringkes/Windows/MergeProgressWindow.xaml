<Window x:Class="Ringkes.Views.MergeProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merging PDF"
        Height="180"
        Width="400">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
                Text="Merging PDF files..."
                FontSize="16"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Name="OutputText"
                Margin="0,10,0,10"
                TextAlignment="Center"/>

            <ProgressBar
                IsIndeterminate="True"
                Height="20"/>

        </StackPanel>

    </Grid>

</Window>