<Window x:Class="Ringkes.MergeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Merge Files"
        Height="450"
        Width="600"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="FileListView"
                  AllowDrop="True"
                  HorizontalContentAlignment="Stretch"
                  PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                  MouseMove="FileListView_MouseMove"
                  Drop="FileListView_Drop">

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Grid Margin="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="{Binding FileName}"
                               ToolTip="{Binding FileName}"
                               VerticalAlignment="Center"
                               Margin="4,0"
                               TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Content="↑"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Tag="{Binding}"
                                Click="MoveUp_Click"
                                ToolTip="Move Up"/>

                        <Button Grid.Column="3"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Content="↓"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Tag="{Binding}"
                                Click="MoveDown_Click"
                                ToolTip="Move Down"/>

                        <Button Grid.Column="4"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE74D;"
                                ToolTip="Delete"
                                Tag="{Binding}"
                                Click="Delete_Click"/>

                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <StackPanel x:Name="EmptyStatePanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <TextBlock Text="No PDF files added yet"
                   FontSize="16"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>

            <TextBlock
                   Text="Drag &amp; Drop PDF files here"
                   FontSize="16"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>

            <TextBlock
                   Text="or click Add Files"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1"
            Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                Content="Add Files"
                Width="100"
                Height="35"
                Click="AddFiles_Click"/>

            <Button x:Name="ReverseButton"
                Grid.Column="1"
                Content="Reverse"
                Width="100"
                Height="35"
                Margin="10,0,0,0"
                Click="ReverseOrder_Click"/>

            <Button Grid.Column="3"
                Content="Clear All"
                Width="100"
                Height="35"
                Margin="10,0,0,0"
                Click="Clear_Click"/>

            <Button Grid.Column="4"
                Content="Close"
                Width="90"
                Height="35"
                Margin="10,0,0,0"
                Click="Close_Click"/>

        </Grid>

    </Grid>

</Window>